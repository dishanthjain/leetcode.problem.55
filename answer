class Solution {
public:
    bool canJump(vector<int>& nums) {
        int reach = 0;

        for (int i = 0; i < nums.size(); i++) {
            if (i > reach)
                return false;

            reach = max(reach, i + nums[i]);

            if (reach >= nums.size() - 1)
                return true;
        }

        return true;
    }
};

Explanation:

Track the farthest index you can reach. If you reach an index beyond that limit, return false; if the last index becomes reachable, return true.
